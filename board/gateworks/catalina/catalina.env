console=ttyLP0,115200
boot_targets=mmc0 mmc1 usb
fdtfile=CONFIG_DEFAULT_FDT_FILE
/* address mapping friendly for 1GiB min DRAM allowing
   - 128MiB for compressed blobs (like FIT images)
   - 128MiB of kernel
   - 1MiB dtb
   - 512KiB script
   - unlimitted ramdisk (at top)
*/
kernel_comp_addr_r=0x90400000
loadaddr=0x98400000
kernel_addr_r=0x98400000
fdt_addr_r=0xa0400000
scriptaddr=0xa0500000
ramdisk_addr_r=0xa0580000
bootm_size=0x10000000
/* erase env */
env_erase=\
   echo "Erasing U-Boot environment..."; \
   mmc dev ${dev} ${bootpart} && \
   mmc erase 0x1f80 0x80 && \
   mmc dev ${dev}
/* network */
autoload=no
ethrotate=no
/* http or tftp */
proto=http
path=catalina/
image=noble-catalina.img.gz
firmware=firmware-catalina.bin
/* show network info */
net_info=\
   echo "ipaddr   : ${ipaddr}"; \
   echo "netmask  : ${netmask}"; \
   echo "gatewayip: ${gatewayip}"; \
   echo "serverip : ${serverip}"; \
   echo "dnsip    : ${dnsip}"; \
   net list
/* protocol-aware network load script:
 * $target_addr (where to load), $target_file (what to load)
 */
net_load=\
   setexpr target_file fmt "%s://%s/%s%s" ${proto} ${serverip} ${path} ${target_name}; \
   if itest.s "${proto}" == "http" || itest.s "${proto}" == "https"; then \
      echo "Fetching ${target_file} to ${target_addr} via HTTP/HTTPS..."; \
      if wget ${target_addr} ${target_file}; then \
         echo "transfer successful"; \
      else \
         echo "transfer failed - check network settings:"; \
         run net_info; \
         false; \
      fi; \
   else \
      echo "Fetching ${target_file} to ${target_addr} via TFTP..."; \
      if tftpboot ${target_addr} ${serverip}:${path}${target_name}; then \
         echo "transfer successful"; \
      else \
         echo "transfer failed - check network settings:"; \
         run net_info; \
         false; \
      fi; \
   fi
/* boot from network */
net_boot=\
   setenv target_addr ${fdt_addr_r}; \
   setenv target_name ${fdtfile}; \
   run net_load && \
   setenv target_addr ${loadaddr}; \
   setenv target_name Image; \
   run net_load && \
   booti ${loadaddr} - ${fdt_addr_r}
/* update boot firmware of boot dev/part */
update_firmware=\
   setenv target_addr ${kernel_comp_addr_r}; \
   setenv target_name ${firmware}; \
   run net_load && \
   setenv fit_addr ${kernel_comp_addr_r} && \
   source ${kernel_comp_addr_r}:update-script && \
   echo "Update successful"
/* update OS (emmc user) of boot dev */
update_os=\
   setenv target_addr ${loadaddr}; \
   setenv target_name ${image}; \
   run net_load && \
   gzwrite mmc ${dev} ${loadaddr} 0x${filesize} && \
   echo "Update sucessful"
